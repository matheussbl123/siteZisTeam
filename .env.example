# Em desenvolvimento, o Vite lê primeiro ../.env (pasta "ZisBetter Team") e depois ./.env (que sobrescreve).
# Em produção, cadastre estas variáveis no projeto da Vercel.

# URL da implantação "App da Web" do apps-script/Code.gs (termina em /exec).
APPS_SCRIPT_URL=
# Texto aleatório longo; o mesmo valor vai na constante SEGREDO do script.
APPS_SCRIPT_SECRET=
